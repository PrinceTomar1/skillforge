# --- Server ---
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL with pgvector extension enabled) ---
DATABASE_URL=postgresql://user:password@localhost:5432/skillforge

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=skillforge_token

# --- AI / LLM provider (used by the AI Tutor and study-resource generation) ---
# Supported: "anthropic" | "gemini" | "none". "none" runs the app with a
# clearly-labeled fallback so every route still works without a key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-20250929
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Embeddings (used by the RAG ingestion + retrieval pipeline) ---
# Supported: "openai" | "local". "local" uses a deterministic hashing-based
# embedding so ingestion/retrieval still work end-to-end without a key
# (clearly weaker semantic quality than a real embedding model).
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- Uploads ---
MAX_UPLOAD_MB=10
